{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Resume Analyzer",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "app.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "resume-analyzer",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "beginsPattern": ".*",
                    "endsPattern": ".*Running on http://.*"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}
